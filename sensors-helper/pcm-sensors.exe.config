<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>
  <runtime>
    <!-- DLLs unpacked from a downloaded zip carry the "from the internet" mark;
         without this .NET Framework refuses to load them (the 1.2/1.3 bug) -->
    <loadFromRemoteSources enabled="true" />
  </runtime>
</configuration>
